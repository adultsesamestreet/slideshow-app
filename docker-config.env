# Slideshow Website Docker Configuration
# Edit these values to customize your setup

# Port to access the website (change if 3000 is already in use)
HOST_PORT=3000

# Path to your images directory (change this to point to your images folder)
# Windows examples:
# IMAGES_PATH=C:\MySlideshowImages
# IMAGES_PATH=D:\Pictures\SlideshowImages

# Linux/Mac examples:
# IMAGES_PATH=/home/user/slideshow-images
# IMAGES_PATH=/mnt/external-drive/images

IMAGES_PATH=./images

# Container restart policy (unless-stopped, always, no)
RESTART_POLICY=unless-stopped

# Environment
NODE_ENV=production
