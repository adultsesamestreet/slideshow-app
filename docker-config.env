# Slideshow Website Docker Configuration
# Copy this file and customize values for your environment.

# Port mapped on your ZimaOS host.
HOST_PORT=3000

# Internal application port used by server.js and health checks.
PORT=3000

# Host path where your image category folders live.
# ZimaOS CasaOS examples:
# IMAGES_PATH=/DATA/Media/slideshow-images
# IMAGES_PATH=/DATA/AppData/slideshow/images
IMAGES_PATH=./images

# Container path used by the app for image discovery.
IMAGES_ROOT=/app/images

# Container restart policy (unless-stopped, always, no)
RESTART_POLICY=unless-stopped

# Environment
NODE_ENV=production
